        </form>

        <script>
            $(document).ready(function () {
                $("#edit-student-form").submit(function (e) {
                    e.preventDefault();

                    var formData = $(this).serialize();

                    $.ajax({
                        url: '@Url.Action("Edit", "Student")',
                        type: 'POST',
                        data: formData,
                        success: function (result) {
                            if (result.success) {
                                location.reload();  // Reload page or update UI
                            } else {
                                alert("Error occurred");
                            }
                        }
                    });
                });
            });
        </script>
