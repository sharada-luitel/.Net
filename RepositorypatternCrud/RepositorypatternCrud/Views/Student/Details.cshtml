        @await Html.PartialAsync("_ParentPartial")
    </div> *@

</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
<script>
    function viewStudentDetails(id) {
        $.get('@Url.Action("Details", "Student")', { id: id }, function (data) {
            $("#modal-container").html(data); // Load details into a modal container
            $("#detailsModal").modal('show'); // Show the modal
        });
    }
</script>

