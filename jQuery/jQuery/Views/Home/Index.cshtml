            <div class="mb-3">
                <label for="exampleFormControlInput1" class="form-label">Fist Number</label>
                <input type="text" class="form-control" id="num1" placeholder="Enter First Number ">
            </div>
            <div class="mb-3">
                <label for="exampleFormControlInput1" class="form-label"> Second Number</label>
                <input type="text" class="form-control" id="num2" placeholder="Enter Second Number">
            </div>
            <br />
            <button class="btn btn-info" onclick="Display1()">Add</button>
            <button class="btn btn-info" onclick="Display2()">Subtract</button>

            <h3 id="result"></h3>
        </div>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        alert("Welcome to jquery");

    });

    // function Display() { 
    //     var name = $("#name").val();
    //     var surname = $("#surname").val();
    //     var data = name + "" + surname;
    //     $("#result").text(data);

    // }
    function Display1() {
        var n1 = parseInt($("#num1").val());
        var n2 = parseInt($("#num2").val());


        $.ajax({
            type: 'Post',
            url: '@Url.Action("Add")',
            data: { num1: n1, num2: n2 },
            dataType: 'text',
            success: function (response, ststus, xhr) {
                $("#result").text(response);

            },
            error: function (req, status, error) {
                $("#result").text(error);

            }
        });


        // var data = num1 + num2;
        // $("#result").text(data);

    }
    function Display2() {
        var n1 = parseInt($("#num1").val());
        var n2 = parseInt($("#num2").val());


        $.ajax({
            type: 'Post',
            url: '@Url.Action("Subtract")',
            data: { num1: n1, num2: n2 },
            dataType: 'text',
            success: function (response, ststus, xhr) {
                $("#result").text(response);

            },
            error: function (req, status, error) {
                $("#result").text(error);

            }
        });


        

    }
    
</script>