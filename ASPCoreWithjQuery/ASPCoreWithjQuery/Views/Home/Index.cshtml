@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
<div class="container">
    <div class="row">
        <div class="col-md-4">
           
            <div class="mb-3">
                <label for="exampleFormControlInput1" class="form-label">First Number</label>
                <input type="Text" class="form-control" id="num1" placeholder="Enter first number">
            </div>
            <div class="mb-3">
                <label for="exampleFormControlInput1" class="form-label">Second Number</label>
                <input type="Text" class="form-control" id="num2" placeholder="Enter Second Number">
            </div>

            <br />
            <button class="btn btn-info" onclick="Display()">Add</button>
            <button class="btn btn-info" onclick="Display!()">Subtract</button>
            <button class="btn btn-info" onclick="calculate()">Calculate</button>
            <br />
            <h3 id="result"></h3>


        </div>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        alert("WElcome To Home");
    });
    
    function Display1() {
       
        var n1 = parseInt($("#num1").val());
        var n2 = parseInt($("#num2").val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("Add")',
            data: { num1: n1, num2: n2 },
            dataType: 'text',
            success: function (response, status, xhr) {
                $("#result").text(response);
            },
            error: function (req, status, error) {
                $("result").text(error);
}

            }

        });

       

    }
    function Display1() {
       
        var n1 = parseInt($("#num1").val());
        var n2 = parseInt($("#num2").val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("Subtract")',
            data: { num1: n1, num2: n2 },
            dataType: 'text',
            success: function (response, status, xhr) {
                $("#result").text(response);
            },
            error: function (req, status, error) {
                $("result").text(error);
}

            }

        });

       

    }
    function calculate() {

        var n1 = parseInt($("#num1").val());
        var n2 = parseInt($("#num2").val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("Calculate")',
            data: { num1: n1, num2: n2 },
            dataType: 'text',
            success: function (response, status, xhr) {
                var data = "Addition Result is: " + response.add +
                    "<br>Subtraction Result is: " + response.subtaract +
                    "<br>Multiplication Result is: " + response.multiply +
                    "<br>Division Result is: " + response.division;



                $("#result").html(data);
            },
            error: function (req, status, error) {
                $("result").text(error);
            }

        }

            });



        }
</script>